+func _dsh_hit_point(cam, branch, mesh):
+	var vp = get_viewport()
+	if vp == null or vp.world_3d == null:
+		return null
+	var space = vp.world_3d.direct_space_state
+	var centre = mesh.global_transform * mesh.get_aabb().get_center()
+	var base = cam.unproject_position(centre)
+	var offs = [
+		Vector2(0, 0), Vector2(0, 40), Vector2(40, 0), Vector2(0, -40), Vector2(-40, 0),
+		Vector2(40, 40), Vector2(-40, 40), Vector2(40, -40), Vector2(-40, -40),
+		Vector2(0, 80), Vector2(80, 0), Vector2(0, -80), Vector2(-80, 0),
+	]
+	for off in offs:
+		var sp = base + off
+		var frm = cam.project_ray_origin(sp)
+		var nrm = cam.project_ray_normal(sp)
+		var q = PhysicsRayQueryParameters3D.create(frm, frm + nrm * 400.0)
+		var hit = space.intersect_ray(q)
+		if hit.is_empty():
+			continue
+		var col = hit.get("collider")
+		if col == null:
+			continue
+		var okp = false
+		if col == mesh:
+			okp = true
+		elif col is Node and mesh.is_ancestor_of(col):
+			okp = true
+		elif col is Node and branch.is_ancestor_of(col):
+			okp = true
+		if okp:
+			return sp
+	return null
