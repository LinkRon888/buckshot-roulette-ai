+# ---------- 1 秒一次的重扫描（只在这里遍历场景树）----------
+func _dsh_scan_all(delta):
+	_dsh_scan_cd -= delta
+	if _dsh_scan_cd > 0.0:
+		return
+	_dsh_scan_cd = 1.0
+	var probe := []
+	var found := {}
+	var descs := []
+	var stack = [get_tree().root]
+	var guard := 0
+	while stack.size() > 0 and guard < 30000:
+		guard += 1
+		var n = stack.pop_back()
+		if n == null:
+			continue
+		var sc = n.get_script()
+		if sc != null:
+			var base = str(sc.resource_path).get_file()
+			if probe.size() < 40:
+				probe.append([str(n.name), base])
+			for w in _DSH_WANTED:
+				if not found.has(str(w[1])) and base == str(w[1]) + ".gd":
+					found[str(w[1])] = n
+			if base == "PickupIndicator.gd":
+				descs.append(n)
+		for c in n.get_children():
+			stack.push_back(c)
+	_dsh_probe = probe
+	_dsh_desc_nodes = descs
+	# 收集所有交互对象（含门、签名键等不在 PermissionManager 里的）
+	var brs2 := []
+	_dsh_branch_nodes = []
+	var stack3 = [get_tree().root]
+	var g3 := 0
+	while stack3.size() > 0 and g3 < 30000:
+		g3 += 1
+		var n3 = stack3.pop_back()
+		if n3 == null:
+			continue
+		var sc3 = n3.get_script()
+		if sc3 != null:
+			var base3 = str(sc3.resource_path).get_file()
+			if base3.find("InteractionBranch") >= 0 or base3.find("SignatureButtonBranch") >= 0:
+				var al3 := ""
+				if "interactionAlias" in n3:
+					al3 = str(n3.interactionAlias)
+				var ok3 := false
+				if "interactionAllowed" in n3:
+					ok3 = bool(n3.interactionAllowed)
+				var pos3 = [-1, -1]
+				var c3 = get_viewport().get_camera_3d()
+				if c3 != null and n3 is Node3D:
+					var pv3 = c3.unproject_position(n3.global_position)
+					pos3 = [int(pv3.x), int(pv3.y)]
+				brs2.append([al3, ok3, pos3[0], pos3[1], str(n3.name)])
+				_dsh_branch_nodes.append(n3)
+		for c4 in n3.get_children():
+			stack3.push_back(c4)
+	_dsh_branches = brs2
+	var sbs := []
+	var stack4 = [get_tree().root]
+	var g4 := 0
+	while stack4.size() > 0 and g4 < 300000:
+		g4 += 1
+		var n4 = stack4.pop_back()
+		if n4 == null:
+			continue
+		var sc4 = n4.get_script()
+		# 宽松判定：脚本路径可能拿不到 get_file()，退回按路径子串 / 有 Press 方法 + intbranch 子节点
+		var is_sign_btn = false
+		if sc4 != null:
