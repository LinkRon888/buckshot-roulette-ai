+func _dsh_dbg(msg):
+	var f = FileAccess.open(_DSH_KOROOT + "sign_debug.txt", FileAccess.READ_WRITE)
+	if f == null:
+		f = FileAccess.open(_DSH_KOROOT + "sign_debug.txt", FileAccess.WRITE)
+	else:
+		f.seek_end()
+	if f != null:
+		f.store_string(str(msg) + "\n")
+		f.close()
+func _dsh_sign_one(letter):
+	# 找 letterAlias == letter 的签名键，输入 + 播放按键动画
+	var sg = _dsh_mgr_get("SignatureManager")
+	if sg == null:
+		return "拒绝：找不到 SignatureManager"
+	for sb in _dsh_sign_buttons:
+		if sb == null or not is_instance_valid(sb):
+			continue
+		var ib = sb.get("intbranch")
+		if ib == null:
+			continue
+		var la := ""
+		if "signatureButton_letterAlias" in ib:
+			la = str(ib.signatureButton_letterAlias)
+		if la == letter:
+			var sa := ""
+			if "signatureButton_specialAlias" in ib:
+				sa = str(ib.signatureButton_specialAlias)
+			sg.call("GetInput", la, sa)
+			sb.call("Press")
+			return ""
+	# 没找到对应键（比如字母不在键盘上）就只输入，不动画
+	sg.call("Input_Letter", letter)
+	return ""
+
+func _dsh_use_item(arg):
+	# 必须走 PickupItemFromTable：它内部依次做
+	#   RemovePlayerItemFromGrid -> queue_free -> InteractWith
+	# 只调 InteractWith 会留下桌上的模型（实测过）
+	var ii = _dsh_mgr_get("ItemInteraction")
+	var im = _dsh_mgr_get("ItemManager")
+	if ii == null or im == null:
+		return "拒绝：找不到 ItemInteraction/ItemManager"
+	if im.items_dynamicInteractionArray == null:
+		return "拒绝：道具数组为空"
+	for it in im.items_dynamicInteractionArray:
+		if it == null:
+			continue
+		if "isPlayerSide" in it and not bool(it.isPlayerSide):
+			continue
+		if str(it.itemName).to_lower() == arg:
+			var par = it.get_parent()
+			if par == null:
+				return "拒绝：道具没有父节点"
+			ii.call("PickupItemFromTable", par, arg)
+			return ""
+	return "拒绝：桌上找不到 " + arg
+
+func d_get_items():
+	var out := []
+	var im = _dsh_mgr_get("ItemManager")
+	if im == null:
+		return out
+	if im.items_dynamicInteractionArray != null:
+		for it in im.items_dynamicInteractionArray:
+			if it != null:
+				out.append(str(it.itemName).to_lower())
+	return out
