+					var nmd := str(itd.itemName) if ("itemName" in itd) else "?"
+					var pls := bool(itd.isPlayerSide) if ("isPlayerSide" in itd) else false
+					var gid := int(itd.itemGridIndex) if ("itemGridIndex" in itd) else -999
+					var vis := false
+					if is_instance_valid(itd):
+						vis = itd.is_inside_tree()
+					outp.append([idx, "OK", nmd, pls, gid, int(itd.get_instance_id()) if is_instance_valid(itd) else -1, vis])
+				idx += 1
+			_dsh_dump_items = outp
+			ok = true
+	elif verb == "steal":
+		var ims = _dsh_mgr_get("ItemManager")
+		var iis = _dsh_mgr_get("ItemInteraction")
+		if ims == null or iis == null:
+			why = "refuse: missing manager"
+		elif arg == "":
+			why = "refuse: need item name"
+		else:
+			var found = false
+			for its in ims.items_dynamicInteractionArray:
+				if its == null:
+					continue
+				if not ("isPlayerSide" in its):
+					continue
+				if bool(its.isPlayerSide):
+					continue
+				if str(its.itemName) != arg:
+					continue
+				var par = its.get_parent()
+				iis.call("PickupItemFromTable", par, arg)
+				found = true
+				break
+			if found:
+				ok = true
+				# 偷到的放大镜是当场使用的，所以也该允许读下一发
+				if str(arg) == "magnifying glass":
+					_dsh_mag_until = Time.get_ticks_msec() + 15000
+			else:
+				why = "refuse: no dealer item named " + arg
+	else:
+		why = "拒绝：不认识的命令 " + verb
+
+	if ok:
+		_dsh_write_result("OK|" + line + "|ms=" + str(Time.get_ticks_msec()))
+		print("[DSH] cmd ok: ", line)
+	else:
+		_dsh_write_result("ERR|" + line + "|" + why)
+		print("[DSH] cmd refused: ", line, " -> ", why)
+
