+			var sp3 = get_viewport().world_3d.direct_space_state
+			var hit3 = sp3.intersect_ray(PhysicsRayQueryParameters3D.create(frm2, to2))
+			if not hit3.is_empty():
+				hn = str(hit3.collider.name)
+		_dsh_last_click = [int(event.position.x), int(event.position.y), hn]
