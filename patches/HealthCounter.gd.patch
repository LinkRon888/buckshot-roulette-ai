+# ===== DSH FOCUS BLOCK =====
+# 只读：现在谁有焦点、控制器模式开没开、射击目标按钮能不能被键盘导航到、
+# 按下回车会连到哪个对象的哪个方法。
+func _dsh_focus_block(d):
+	var fb := {}
+	var fo = null
+	var vp = get_viewport()
+	if vp != null:
+		fo = vp.gui_get_focus_owner()
+	if fo != null and is_instance_valid(fo):
+		fb["owner"] = [str(fo.name), str(fo.get_path()), str(fo.get_class()), int(fo.focus_mode)]
+	else:
+		fb["owner"] = ["", "", "", -1]
+	var cm = _dsh_mgr_get("ControllerManager")
+	if cm != null:
+		var pf = cm.get("previousFocus")
+		var pfn := ""
+		var pfp := ""
+		if pf != null and is_instance_valid(pf):
+			pfn = str(pf.name)
+			if pf.is_inside_tree():
+				pfp = str(pf.get_path())
+		fb["previous"] = [pfn, pfp]
+		fb["fs1"] = bool(cm.get("fs1"))
+		fb["fs2"] = bool(cm.get("fs2"))
+		fb["enabled"] = bool(cm.get("controller_currently_enabled"))
+	var cur2 = _dsh_mgr_get("CursorManager")
+	if cur2 != null:
+		fb["cursor_active"] = bool(cur2.get("controller_active"))
+		fb["cursor_visible"] = bool(cur2.get("cursor_visible"))
+	var kids := []
+	var ss = _dsh_mgr_get("ShotgunShooting")
+	if ss != null:
+		var bp = ss.get("btnParent_shootingChoice")
+		if bp != null and is_instance_valid(bp):
+			fb["parent_visible"] = bool(bp.visible)
+			var byou = ss.get("btn_you")
+			if byou != null and is_instance_valid(byou):
+				fb["btn_you"] = [str(byou.name), str(byou.get_path())]
+			for ch in bp.get_children():
+				if ch == null or not (ch is Control):
+					continue
+				var one := []
+				one.append(str(ch.name))
+				one.append(str(ch.get_class()))
+				one.append(bool(ch.visible))
+				one.append(int(ch.focus_mode))
+				one.append([str(ch.focus_neighbor_left), str(ch.focus_neighbor_top), str(ch.focus_neighbor_right), str(ch.focus_neighbor_bottom)])
+				var cons := []
+				for c in ch.get_signal_connection_list("pressed"):
+					var cb = c.get("callable")
+					if cb != null:
+						var ob = cb.get_object()
+						var on := ""
+						var op := ""
+						if ob != null and is_instance_valid(ob):
+							on = str(ob.name)
+							if ob.is_inside_tree():
+								op = str(ob.get_path())
+						cons.append([str(cb.get_method()), on, op])
+				one.append(cons)
+				var hf := false
+				if fo != null and is_instance_valid(fo) and fo == ch:
+					hf = true
+				one.append(hf)
+				kids.append(one)
+	fb["shooting_choice"] = kids
+	fb["focusables"] = _dsh_focusables
+	d["focus"] = fb
