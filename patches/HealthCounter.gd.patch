+# ---------- 工具 ----------
+func _dsh_simple_value(n, nm):
+	var v = n.get(nm)
+	var t = typeof(v)
+	if t == TYPE_INT or t == TYPE_FLOAT or t == TYPE_BOOL or t == TYPE_STRING:
+		return v
+	if t == TYPE_ARRAY:
+		var arr := []
+		for x in v:
+			var tx = typeof(x)
+			if tx == TYPE_INT or tx == TYPE_FLOAT or tx == TYPE_BOOL or tx == TYPE_STRING:
+				arr.append(x)
+			else:
+				return null
+		return arr
+	return null
+
+
+func _dsh_dump_node(n):
+	var out := {}
+	if n == null:
+		return out
+	for p in n.get_property_list():
+		var nm = str(p.name)
+		if nm.begins_with("_") or nm == "script" or nm == "resource_local_to_scene":
+			continue
+		var sv = _dsh_simple_value(n, nm)
+		if sv != null:
+			out[nm] = sv
+	return out
